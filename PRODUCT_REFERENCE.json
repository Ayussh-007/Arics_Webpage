  "commonIssues": {
    "imagesNotLoading": {
      "causes": [
        "Invalid image URL",
        "CORS policy blocking",
        "Image server down"
      ],
      "solutions": [
        "Use CDN URLs (Unsplash, Cloudinary)",
        "Verify HTTPS protocol",
        "Check image exists at URL"
      ]
    },
    "productsNotDisplaying": {
      "causes": [
        "Backend not running",
        "Database not seeded",
        "isActive set to false"
      ],
      "solutions": [
        "Start backend: npm --prefix server start",
        "Seed database: npm --prefix server run seed",
        "Check product isActive status"
      ]
    },
    "adminCannotAccess": {
      "causes": [
        "Not logged in",
        "Token expired",
        "Not admin role"
      ],
      "solutions": [
        "Login with admin credentials",
        "Clear localStorage and re-login",
        "Verify user role in database"
      ]
    }
  }
