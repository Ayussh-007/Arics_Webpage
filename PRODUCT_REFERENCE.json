  "priceCalculations": {
    "effectivePrice": "discountedPrice || originalPrice",
    "discountAmount": "originalPrice - discountedPrice",
    "discountPercentage": "((originalPrice - discountedPrice) / originalPrice) * 100",
    "hasDiscount": "discountedPrice && discountedPrice < originalPrice"
  },
  
  "validationRules": {
    "name": {
      "required": true,
      "type": "string",
      "trim": true,
      "example": "Valentine's Rose Bouquet"
    },
    "description": {
      "required": true,
      "type": "string",
      "maxLength": 200,
      "example": "A beautiful arrangement..."
    },
    "image": {
      "required": true,
      "type": "string",
      "format": "url",
      "example": "https://images.unsplash.com/photo-xyz"
    },
    "originalPrice": {
      "required": true,
      "type": "number",
      "min": 0,
      "example": 129.99
    },
    "discountedPrice": {
      "required": false,
      "type": "number",
      "min": 0,
      "mustBeLessThan": "originalPrice",
      "example": 99.99
    },
    "category": {
      "required": true,
      "type": "string",
      "enum": ["bouquet", "arrangement", "plant", "gift", "subscription"],
      "default": "bouquet"
    },
    "stock": {
      "required": true,
      "type": "number",
      "min": 0,
      "default": 0,
      "example": 25
    },
    "offerBadge": {
      "required": false,
      "type": "string",
      "maxLength": 50,
      "example": "Valentine's Special"
    },
    "tags": {
      "required": false,
      "type": "array",
      "items": "string",
      "example": ["roses", "premium", "luxury"]
    }
  },
  
  "apiExamples": {
    "getAllProducts": {
      "method": "GET",
      "url": "/api/products",
      "query": {
        "category": "bouquet",
        "sortBy": "popularity",
        "order": "desc",
        "hasOffer": "true"
      },
      "response": {
        "products": "Product[]",
        "total": 12,
        "page": 1,
        "pages": 2
      }
    },
    "getProductById": {
      "method": "GET",
      "url": "/api/products/:id",
      "response": "Product object"
    },
    "createProduct": {
      "method": "POST",
      "url": "/api/products",
      "headers": {
        "Authorization": "Bearer <admin-token>",
        "Content-Type": "application/json"
      },
      "body": {
        "name": "New Product",
        "description": "Description here",
        "image": "https://...",
        "originalPrice": 99.99,
        "category": "bouquet",
        "stock": 10
      }
    },
    "updateProduct": {
      "method": "PUT",
      "url": "/api/products/:id",
      "headers": {
        "Authorization": "Bearer <admin-token>",
        "Content-Type": "application/json"
      },
      "body": "Partial or full product data"
    },
    "toggleStatus": {
      "method": "PATCH",
      "url": "/api/products/:id/toggle",
      "headers": {
        "Authorization": "Bearer <admin-token>"
      }
    },
    "deleteProduct": {
      "method": "DELETE",
      "url": "/api/products/:id",
      "headers": {
        "Authorization": "Bearer <admin-token>"
      }
    },
    "incrementPopularity": {
      "method": "POST",
      "url": "/api/products/:id/view",
      "note": "Called when user views or adds to cart"
    }
  },
  
  "frontendIntegration": {
    "fetchProducts": {
      "file": "src/pages/ProductsPage.jsx",
      "function": "fetchProducts()",
      "triggers": ["component mount", "filter change", "sort change"]
    },
    "displayProduct": {
      "file": "src/components/ProductCard.jsx",
      "props": ["product", "onViewDetails", "onCustomize", "onAddToCart"]
    },
    "manageProduct": {
      "file": "src/pages/AdminDashboard.jsx",
      "operations": ["create", "read", "update", "delete", "toggle"]
    },
    "productForm": {
      "file": "src/components/ProductForm.jsx",
      "modes": ["create", "edit"],
      "validation": "client-side + server-side"
    }
  },
  
