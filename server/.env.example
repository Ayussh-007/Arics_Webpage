# --- Server environment example ---
# Web server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/arics

# Auth
JWT_SECRET=change_me_please

# Mail (set these to actually send email)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Arics <no-reply@arics.com>"

# Payments (server-built QR, optional if you send custom HTML with your own image)
# Mode 1: UPI QR
PAYMENT_QR_MODE=upi
PAYMENT_UPI_ID=yourupi@bank
PAYMENT_UPI_NAME=Arics
# Mode 2: Raw payload
# PAYMENT_QR_MODE=payload
# PAYMENT_QR_PAYLOAD=upi://pay?pa=yourupi@bank&pn=Arics&am=0.00&cu=INR&tn=Arics%20Order

# Backend Environment Variables
PORT=5002
MONGODB_URI=mongodb://localhost:27017/arics_bouquet
JWT_SECRET=replace_with_strong_secret
ADMIN_EMAIL=admin@arics.com
ADMIN_PASSWORD=ChangeMe123!

# Email (SMTP) configuration
# You can use Gmail SMTP with an App Password, SendGrid SMTP, Mailgun SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Arics <no-reply@arics.com>"

# Payment QR configuration
# Option A (recommended): Generate a UPI payment QR that includes the order total.
PAYMENT_QR_MODE=upi
PAYMENT_UPI_ID=your-upi-id@bank
PAYMENT_UPI_NAME=Arics

# Option B: Use a fixed QR payload (link/text) instead.
# PAYMENT_QR_MODE=payload
# PAYMENT_QR_PAYLOAD=https://your-payment-link.example.com
